# Database Configuration
# Option 1: Local PostgreSQL
# DATABASE_URL=postgresql://username:password@localhost:5432/inventory_billing_db

# Option 2: Supabase (Recommended) Pass:  IMS-Inventory-System
DATABASE_URL=postgresql://postgres:IMS-Inventory-System@db.cuojbemrawdumjappecu.supabase.co:5432/postgres

# JWT Secret (Generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Secret Bypass Key for Secret Key Approvals (Admin only - CRITICAL)
SECRET_BYPASS_KEY=scrap2024secret

# Google Sheets Integration
GOOGLE_SHEET_ID=your-google-sheet-id-here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com

# Google Service Account Private Key (JSON format - escape newlines or use base64)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Private Key Here\n-----END PRIVATE KEY-----\n"

# Google Apps Script Webhook (Alternative to Service Account)
GAS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
GAS_WEBHOOK_SECRET=your-shared-webhook-secret-key

# Session Configuration
SESSION_COOKIE_NAME=ims_session
SESSION_MAX_AGE=86400

# Application Port (optional)
PORT=3000
